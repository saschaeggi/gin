use Drupal\gin\Hook\PreprocessHooks;

/**
 * Provides the preprocess class.
 *
 * @return \Drupal\gin\Hook\PreprocessHooks
 *   The preprocess class.
 */
function _gin_preprocess_class(): PreprocessHooks {
  static $class;
  if (!isset($class)) {
    $class = Drupal::classResolver(PreprocessHooks::class);
  }
  return $class;
}

/**
 * Implements template_preprocess_HOOK() for admin_block.
 */
function gin_preprocess_admin_block(array &$variables): void {
  _gin_preprocess_class()->adminBlock($variables);
}

