+   * @return \Drupal\Core\Hook\ThemeImplementationList
+   *   Object with hook implementation callbacks and their modules.
+   */
+  protected function getHookImplementationList(string $hook): ThemeImplementationList {
+    if (!isset($this->hookImplementationLists[$hook])) {
+      if ($this->hookLists === NULL) {
+        if ($cache = $this->cache->get('theme_hook_data')) {
+          $hook_data = $cache->data;
+        }
+        else {
+          $hook_data = $this->keyValueFactory->get('hook_data')->getMultiple([
+            'theme_hook_list',
+            'theme_includes',
+          ]);
+          $this->cache->set('theme_hook_data', $hook_data);
+        }
+        $this->hookLists = $hook_data['theme_hook_list'] ?? [];
+        $this->hookIncludes = $hook_data['theme_includes'] ?? [];
+      }
+      $hook_list = $this->hookLists[$hook] ?? [];
+      if ($hook_list) {
+        $listeners = [];
+        $themes = [];
+
+        // @todo do we need this.
+        foreach ($this->hookIncludes[$hook] ?? [] as $include) {
+          include_once $include;
+        }
+        foreach ($hook_list as $identifier => $theme) {
+          $listeners[] = $this->callableResolver->getCallableFromDefinition($identifier);
+          $themes[] = $theme;
+        }
+
+        $list = new ThemeImplementationList($listeners, $themes);
+        $this->hookImplementationLists[$hook] = $list;
+      }
+      else {
+        // Set an empty implementation list.
+        $this->hookImplementationLists[$hook] = new ThemeImplementationList([], []);
+      }
+    }
