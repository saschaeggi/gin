@@ -0,0 +1,52 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Core\Hook;
+
+/**
+ * Contains the ordered list of implementations for a hook.
+ *
+ * Also contains information about theme names.
+ *
+ * @internal
+ */
+class ThemeImplementationList {
+
+  /**
+   * Constructor.
+   *
+   * @param list<callable> $listeners
+   *   List of hook implementation callbacks.
+   * @param list<string> $themes
+   *   The theme name associated with each hook implementation.
+   *   This must have the same keys as $listeners.
+   */
+  public function __construct(
+    public readonly array $listeners,
+    public readonly array $themes,
+  ) {
+    assert(array_is_list($listeners));
+    assert(array_is_list($themes));
+    assert(count($listeners) === count($themes));
+    assert(array_filter($listeners, is_callable(...)) === $listeners);
+    assert(array_filter($themes, is_string(...)) === $themes, (new \Exception())->getTraceAsString());
+  }
+
+  /**
+   * Gets listeners for a specific theme.
+   *
+   * @param string $theme
+   *   Theme name.
+   *
+   * @return list<callable>
+   *   Listeners for that theme.
+   */
+  public function getForTheme(string $theme): array {
+    return array_values(array_intersect_key(
+      $this->listeners,
+      array_intersect($this->themes, [$theme]),
+    ));
+  }
+
+}
