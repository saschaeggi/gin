+      $modulePreprocessForSuggestion = $this->keyValueFactory->get('hook_data')->get('preprocess_for_suggestions') ?: [];
+      $themePreprocessForSuggestion = $this->keyValueFactory->get('hook_data')->get('theme_preprocess_for_suggestions') ?: [];
+      $this->preprocessForSuggestions = array_merge($modulePreprocessForSuggestion, $themePreprocessForSuggestion);
     }
     return $this->preprocessForSuggestions;
   }
